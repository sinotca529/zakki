{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-style.sh\"",
            "statusMessage": "文体を確認しています"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__github__(add_comment_to_pending_review|add_issue_comment|add_reply_to_pull_request_comment|pull_request_review_write|issue_write)",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-style.sh\"",
            "statusMessage": "文体を確認しています"
          }
        ]
      }
    ]
  }
}
